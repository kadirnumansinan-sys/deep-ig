# VPS üzerinde dışarı açılacak port.
APP_PORT=3000

# Docker/VPS kalıcı veriyi kendi volume'ünde tutar. Yalnızca özel bir yol gerekiyorsa değiştirin.
DEEPBRIEF_DB_PATH=/data/deepbrief.sqlite

# Opsiyonel: bugünün haber havuzunu ve yayın görseli seçeneklerini genişletir.
NEWSAPI_KEY=

# Opsiyonel: kaynak tabanlı metin üretimi ve görsel kalite artırma işlemlerinde OpenAI kullanılır.
# Anahtarı tarayıcıya veya kaynak koda yazmayın; yalnızca sunucu ortamında tutun.
OPENAI_API_KEY=
OPENAI_DAILY_COPY_LIMIT=40
OPENAI_DAILY_UPSCALE_LIMIT=6

# Ücretsiz sağlayıcı havuzu. Hepsi OpenAI uyumlu /chat/completions konuşur ve
# sırayla denenir; bir sağlayıcının kotası dolduğunda sıradakine geçilir.
# Deneme sırası: 1) Cerebras  2) Groq #1  3) Groq #2  4) Gemini
#   - Cerebras ilk sırada: ücretsiz katmanı en cömert olan (~1M token/gün) sağlayıcı.
#     Öne alınması, dar olan Groq kotasını yalnızca Groq'ta çalışabilen arama için korur.
#   - Gemini son sırada: ücretsiz katmanı düşük RPM'li, taşma katmanı olarak kullanılır.
# Arama (`groq/compound`, dahili web araması) yalnızca Groq'ta çalışır, devredilemez.

# 1) Cerebras — https://cloud.cerebras.ai (ücretsiz)
# İkinci bir hesabın anahtarı CEREBRAS_API_KEY2'ye yazılır; birincisi tükenince sıra ona geçer.
CEREBRAS_API_KEY=
CEREBRAS_API_KEY2=
CEREBRAS_ANALYSIS_MODEL=gpt-oss-120b
CEREBRAS_COPY_MODEL=gpt-oss-120b
# Boş bırakılırsa günlük güvenlik sınırı anahtar başına 250/150 olur (2 anahtar = 500/300).
# Aşağıdaki değerler yazılırsa mutlak kabul edilir, anahtar sayısıyla çarpılmaz.
CEREBRAS_DAILY_ANALYSIS_LIMIT=
CEREBRAS_DAILY_COPY_LIMIT=

# 2-3) Groq — https://console.groq.com (ücretsiz)
# Anahtarlar yalnızca sunucuda kalır. Aynı organizasyona ait anahtarlar genellikle aynı kotayı paylaşır.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
GROQ_SEARCH_MODEL=groq/compound
# Aynı organizasyon/projedeki iki anahtar için true bırakın. Farklı bağımsız projelerse false yapılabilir.
GROQ_KEYS_SHARE_QUOTA=true
# Groq'nun ücretsiz resmi sınırlarından bilinçli olarak çok daha düşük uygulama sınırları.
# Not: "Konum bul" da analiz kotasını paylaşır; bir kanal taraması 24 aday için 2 analiz çağrısı kullanabilir.
GROQ_DAILY_ANALYSIS_LIMIT=40
GROQ_DAILY_SEARCH_LIMIT=16
GROQ_GAP_CACHE_HOURS=6
# Metin üretiminde önce ücretsiz havuz denenir; hepsi tükenirse OpenAI'ye düşülür.
GROQ_COPY_MODEL=openai/gpt-oss-120b
GROQ_DAILY_COPY_LIMIT=30

# 4) Gemini (Google AI Studio) — https://aistudio.google.com/apikey (ücretsiz)
# OpenAI uyumluluk katmanı `reasoning_effort`, `max_completion_tokens` ve şema `strict`
# alanlarını kabul etmiyor; istek gövdesi bu slot için otomatik sadeleştirilir.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_COPY_MODEL=gemini-2.5-flash
GEMINI_DAILY_ANALYSIS_LIMIT=60
GEMINI_DAILY_COPY_LIMIT=40

# Keşif ayarları. DISCOVERY_RECENT_HOURS: "bugün"e ek olarak son N saatin haberleri de havuza girer (0 = kapalı).
DISCOVERY_RECENT_HOURS=8
DISCOVERY_GOOGLE_NEWS_ITEMS=100
DISCOVERY_PUBLISHER_FEED_ITEMS=120
DISCOVERY_GDELT_MAX_RECORDS=180

# Arka plan tarayıcısı. Üretimde uzun ve rastgele bir değer kullanın.
INTERNAL_POLL_TOKEN=replace-with-a-long-random-token
# Vercel Cron'dan poll çalıştırmak için eklenir: /api/internal/poll?token=...
# Bu değeri INTERNAL_POLL_TOKEN ile aynı yapmak zorunda değilsin.
DEEPBRIEF_CRON_TOKEN=
POLL_INTERVAL_SECONDS=600
# Docker/VPS: yayın kuyruğunu tetikleyen publisher servisinin bekleme süresi.
PUBLISH_INTERVAL_SECONDS=300

# Üç kullanıcılı güvenli erişim. Parola en az 12, AUTH_SECRET en az 32 karakter olmalı.
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Deepbrief Owner

# Üretimde uzun ve rastgele bir değer kullanın (ör. openssl rand -hex 32).
IMAGE_PROXY_SECRET=burayi-uzun-rastgele-bir-degerle-degistirin

# --- Planlı Instagram yayını -------------------------------------------------
# Yayın kuyruğu (Vercel → Storage → Neon Postgres bunu otomatik ekler).
DATABASE_URL=
# Medya deposu (Vercel → Storage → Blob store, Public). Vercel otomatik ekler.
BLOB_READ_WRITE_TOKEN=
# Yayın uç noktasını harici cron 5 dakikada bir tetikler:
#   https://<site>/api/internal/publish?token=<DEEPBRIEF_CRON_TOKEN>

IG_GRAPH_VERSION=v25.0
# Host yalnızca graph.instagram.com (Instagram Login) veya graph.facebook.com
# (Facebook Login / Sayfa token'ı) olabilir; boş bırakılırsa graph.instagram.com.
IG_NEWS_USER_ID=
IG_NEWS_TOKEN=
IG_NEWS_HOST=graph.instagram.com

IG_MEDIA_USER_ID=
IG_MEDIA_TOKEN=
IG_MEDIA_HOST=

IG_INTERNATIONAL_USER_ID=
IG_INTERNATIONAL_TOKEN=
IG_INTERNATIONAL_HOST=

IG_HISTORY_USER_ID=
IG_HISTORY_TOKEN=
IG_HISTORY_HOST=
