# VPS üzerinde dışarı açılacak port.
APP_PORT=3000

# Docker/VPS kalıcı veriyi kendi volume'ünde tutar. Yalnızca özel bir yol gerekiyorsa değiştirin.
DEEPBRIEF_DB_PATH=/data/deepbrief.sqlite

# Opsiyonel: bugünün haber havuzunu ve yayın görseli seçeneklerini genişletir.
NEWSAPI_KEY=

# Opsiyonel: kaynak tabanlı metin üretimi ve görsel kalite artırma işlemlerinde OpenAI kullanılır.
# Anahtarı tarayıcıya veya kaynak koda yazmayın; yalnızca sunucu ortamında tutun.
OPENAI_API_KEY=
OPENAI_DAILY_COPY_LIMIT=40
OPENAI_DAILY_UPSCALE_LIMIT=6

# Ücretsiz Groq katmanı: haber açığı taraması ve kaynaklar arası editoryal analiz.
# Anahtarlar yalnızca sunucuda kalır. Aynı organizasyona ait anahtarlar genellikle aynı kotayı paylaşır.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
GROQ_SEARCH_MODEL=groq/compound
# Aynı organizasyon/projedeki iki anahtar için true bırakın. Farklı bağımsız projelerse false yapılabilir.
GROQ_KEYS_SHARE_QUOTA=true
# Groq'nun ücretsiz resmi sınırlarından bilinçli olarak çok daha düşük uygulama sınırları.
GROQ_DAILY_ANALYSIS_LIMIT=40
GROQ_DAILY_SEARCH_LIMIT=16
GROQ_GAP_CACHE_HOURS=6

# Arka plan tarayıcısı. Üretimde uzun ve rastgele bir değer kullanın.
INTERNAL_POLL_TOKEN=replace-with-a-long-random-token
# Vercel Cron'dan poll çalıştırmak için eklenir: /api/internal/poll?token=...
# Bu değeri INTERNAL_POLL_TOKEN ile aynı yapmak zorunda değilsin.
DEEPBRIEF_CRON_TOKEN=
POLL_INTERVAL_SECONDS=600

# Üç kullanıcılı güvenli erişim. Parola en az 12, AUTH_SECRET en az 32 karakter olmalı.
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Deepbrief Owner

# Üretimde uzun ve rastgele bir değer kullanın (ör. openssl rand -hex 32).
IMAGE_PROXY_SECRET=burayi-uzun-rastgele-bir-degerle-degistirin
